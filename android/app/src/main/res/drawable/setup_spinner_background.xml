<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_focused="true"><shape><solid android:color="@color/setup_surface" /><corners android:radius="12dp" /><stroke android:width="2dp" android:color="@color/setup_accent" /></shape></item>
            <item android:state_pressed="true"><shape><solid android:color="@color/setup_lilac" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="@color/setup_accent" /></shape></item>
            <item android:state_enabled="false"><shape><solid android:color="@color/setup_background" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="@color/setup_border" /></shape></item>
            <item><shape><solid android:color="@color/setup_surface" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="@color/setup_border" /></shape></item>
        </selector>
    </item>
    <item android:drawable="@drawable/setup_chevron" android:gravity="end|center_vertical" android:right="14dp" android:width="20dp" android:height="20dp" />
</layer-list>
