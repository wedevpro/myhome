<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_header" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:gravity="center_vertical" android:background="@drawable/widget_touch">
            <ImageView android:id="@+id/widget_icon" android:layout_width="27dp" android:layout_height="27dp"
                android:src="@drawable/widget_icon_basket" android:contentDescription="@null" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="9dp" android:text="MyHomeIA"
                android:textSize="20sp" android:textStyle="bold" android:textColor="#25342A" android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="48dp"
            android:background="@drawable/widget_touch" android:src="@drawable/widget_refresh" android:padding="11dp"
            android:contentDescription="Actualiser la liste"/>
        <ImageButton android:id="@+id/widget_configure" android:layout_width="44dp" android:layout_height="48dp"
            android:background="@drawable/widget_touch" android:src="@drawable/widget_settings" android:padding="12dp"
            android:contentDescription="Choisir le foyer et la liste"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#657365" android:textSize="12sp" android:paddingBottom="6dp"/>
    <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginBottom="5dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_add" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="6dp"
            android:background="@drawable/widget_add_background" android:text="＋  Ajouter un élément…"
            android:textSize="15sp" android:textColor="#2E593B" android:contentDescription="Ajouter un élément à la liste"/>
        <ImageButton android:id="@+id/widget_scan" android:layout_width="48dp" android:layout_height="match_parent"
            android:layout_marginStart="6dp" android:background="@drawable/widget_add_background" android:src="@drawable/widget_barcode"
            android:padding="12dp" android:contentDescription="Scanner un code-barres"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_items" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="#E5EADD" android:dividerHeight="1dp" android:scrollbars="vertical" android:clipToPadding="false"/>
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="12dp" android:textSize="15sp" android:textColor="#657365"
            android:text="Choisissez votre liste."/>
    </FrameLayout>
    <TextView android:id="@+id/widget_clear" android:layout_width="match_parent" android:layout_height="44dp"
        android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="5dp"
        android:background="@drawable/widget_touch" android:textColor="#8B5345" android:textSize="13sp" android:visibility="gone"/>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="5dp" android:textSize="11sp" android:textColor="#657365" android:maxLines="3" android:ellipsize="end"/>
</LinearLayout>
