<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_scan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/quick_scan_action"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_add_background"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/quick_scan_title"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="56dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/quick_scan_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_barcode"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quick_scan_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/quick_scan_action_label"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/quick_scan_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/quick_scan_choose_list"
                android:textColor="@color/widget_muted"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/quick_scan_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/quick_scan_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical|end"
        android:background="@drawable/widget_touch"
        android:contentDescription="@string/quick_scan_settings_description"
        android:padding="14dp"
        android:src="@drawable/widget_settings"/>
</FrameLayout>
