<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/setup_accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/setup_background</item>
        <item name="android:navigationBarColor">@color/setup_legacy_navigation</item>
        <item name="android:windowBackground">@color/setup_background</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="AppThemeDarkBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/setup_accent_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/setup_background</item>
        <item name="android:navigationBarColor">@color/setup_background</item>
        <item name="android:windowBackground">@color/setup_background</item>
        <item name="android:textColorPrimary">@color/setup_text</item>
        <item name="android:textColorSecondary">@color/setup_muted</item>
    </style>
    <style name="AppThemeDark" parent="AppThemeDarkBase" />
</resources>
