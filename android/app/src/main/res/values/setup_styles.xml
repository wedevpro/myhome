<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetSetupTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/setup_background</item>
        <item name="android:statusBarColor">@color/setup_background</item>
        <item name="android:colorAccent">@color/setup_accent</item>
        <item name="android:colorControlHighlight">@color/setup_ripple</item>
        <item name="android:textColorPrimary">@color/setup_text</item>
        <item name="android:textColorSecondary">@color/setup_muted</item>
    </style>
    <style name="WidgetSetupButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/setup_secondary_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/setup_secondary_button_text</item>
    </style>
    <style name="WidgetSetupButtonPrimary" parent="WidgetSetupButton">
        <item name="android:background">@drawable/setup_primary_background</item>
        <item name="android:textColor">@color/setup_primary_button_text</item>
    </style>
    <style name="WidgetSetupButtonQuiet" parent="WidgetSetupButton">
        <item name="android:background">@drawable/setup_quiet_background</item>
        <item name="android:textColor">@color/setup_muted</item>
    </style>
</resources>
